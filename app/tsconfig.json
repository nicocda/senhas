{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Node scripts have their own tsconfig (with Node's types, kept out of the app).
  // Replaces the base's exclude, so its entries are repeated.
  "exclude": ["scripts", "node_modules", "babel.config.js", "metro.config.js", "android", "ios"]
}
