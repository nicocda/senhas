{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-before-commit.mjs\"",
            "timeout": 180,
            "statusMessage": "Corriendo npm run check antes del commit..."
          }
        ]
      }
    ]
  }
}
